# ============================================================
# N3N Flow Platform - Environment Variables
# ============================================================
# Copy this file to .env and update values for your environment.
# Default values are suitable for local development only.
# ============================================================

# Database
POSTGRES_PASSWORD=change_me_to_secure_password

# Redis
REDIS_PASSWORD=change_me_to_secure_password

# MongoDB
MONGO_USER=n3n_admin
MONGO_PASSWORD=change_me_to_secure_password

# Application
JWT_SECRET=change_me_to_random_64_char_string

# CORS (comma-separated list of allowed origins)
# ALLOWED_ORIGINS=https://your-domain.com

# JPA DDL Auto (use 'validate' in production)
# DDL_AUTO=validate
