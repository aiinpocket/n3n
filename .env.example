# ============================================================
# N3N Flow Platform - Environment Variables
# ============================================================
# Copy this file to .env and update values for your environment.
# Most settings are optional — N3N works out of the box with defaults.
# ============================================================

# ---------- Application ----------
# N3N_PORT=8080

# ---------- Database (defaults work with bundled PostgreSQL) ----------
# POSTGRES_PASSWORD=your_secure_password

# ---------- Redis (defaults work with bundled Redis) ----------
# REDIS_PASSWORD=your_secure_password

# ---------- MongoDB (only needed for MongoDB workflow nodes) ----------
# MONGO_USER=n3n_admin
# MONGO_PASSWORD=your_secure_password
# MONGO_DB=n3n_test

# ---------- Security ----------
# JWT Secret (auto-generated on first startup, stored in database)
# Only set this for cluster deployments where multiple instances share a key:
# JWT_SECRET=<base64 encoded 32-byte key>

# Master Key (auto-generated in development, REQUIRED in production)
# Generate: openssl rand -base64 32
# N3N_MASTER_KEY=<base64 encoded 32-byte key>

# ---------- Base URL (required for production) ----------
# Set this to your public-facing URL so Webhook URLs and email links work correctly.
# Without this, they default to http://localhost:8080.
# N3N_SERVER_BASE_URL=https://your-domain.com

# ---------- CORS ----------
# Set this when deploying to a custom domain:
# ALLOWED_ORIGINS=https://your-domain.com

# ============================================================
# Production Deployment Checklist
# ============================================================
# Before deploying to public internet, uncomment and set:
#
# 1. Strong database passwords:
# POSTGRES_PASSWORD=<generate a strong password>
# REDIS_PASSWORD=<generate a strong password>
# MONGO_PASSWORD=<generate a strong password>
#
# 2. Production mode + schema validation:
# SPRING_PROFILES_ACTIVE=prod
# DDL_AUTO=validate
#
# 3. CORS for your domain:
# ALLOWED_ORIGINS=https://your-domain.com
#
# 4. Master encryption key (persist this securely!):
# N3N_MASTER_KEY=<openssl rand -base64 32>
#
# 5. Public-facing base URL (for Webhook URLs and email links):
# N3N_SERVER_BASE_URL=https://your-domain.com
