      "fal",
      "image",
      "video",
      "圖片",
      "影片",
      "生成",
      "flux",
      "veo",
      "kling"
    ],
    "useCases": [
      "以 fal.ai 生成圖片（FLUX）與影片（Veo / Kling / Hailuo）"
    ],
    "relatedNodes": [
      "aiVision",
      "saveArtifact"
    ],
    "bestPractices": "config 必須同時包含 resource 與 operation：圖片用 resource=image、operation=generate；影片用 resource=video、operation=textToVideo 或 imageToVideo。prompt 建議使用英文描述。此節點會自動把產出存入使用者的作品庫並輸出 artifactId 與 downloadUrl，「絕對不要」再接 saveArtifact 節點重複儲存。輸出欄位：imageUrl（第一張圖的 URL 字串）、images（URL 字串陣列，不是物件陣列，沒有 .url 屬性）、videoUrl、artifactId、downloadUrl。",
    "outputFormats": [
      "imageUrl: 第一張圖片 URL（字串）",
      "images: 圖片 URL 字串陣列（引用第一張請用 images[0] 或 imageUrl，不要用 images[0].url）",
      "videoUrl: 影片 URL（字串）",
      "artifactId / downloadUrl: 已自動存入作品庫的檔案 ID 與站內下載連結"
    ],
    "examples": [
      {
        "scenario": "文生圖（FLUX）",
        "config": {
          "resource": "image",
          "operation": "generate",
          "model": "fal-ai/flux/schnell",
          "prompt": "A cozy coffee shop interior, warm lighting, watercolor style",
          "imageSize": "landscape_16_9"
        },
        "expectedOutput": "imageUrl"
      },
      {
        "scenario": "文生影片",
        "config": {
          "resource": "video",
          "operation": "textToVideo",
          "model": "fal-ai/kling-video/v2.1/standard/text-to-video",
          "prompt": "A time-lapse of clouds over a mountain lake"
        },
        "expectedOutput": "videoUrl"
      }
    ]
  },
